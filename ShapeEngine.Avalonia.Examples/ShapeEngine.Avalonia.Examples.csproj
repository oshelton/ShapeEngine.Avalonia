<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latestmajor</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShapeEngine.Avalonia\ShapeEngine.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DaveGreen.ShapeEngine" Version="5.3.0" />
    <PackageReference Include="Avalonia.Markup.Declarative" Version="12.1.0" />
    <!-- The example UI is themed entirely by ShadUI - https://github.com/accntech/shad-ui - which
         restyles the stock Avalonia controls and brings its own SimpleTheme base, so no Fluent theme is
         referenced. -->
    <PackageReference Include="ShadUI" Version="0.2.4" />
    <!-- ShadUI asks for these three at 12.1.0, which would leave them a patch behind the 12.1.1 core
         ShapeEngine.Avalonia pins. Themes.Simple is the one that matters: it templates the control root
         the surfaces are built on, so it is kept in step with the Avalonia it is templating. -->
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
  </ItemGroup>


</Project>
